# URL pública del sitio, usada para SEO / Open Graph (og:image, og:url),
# sitemap y robots. NO es secreto (es un dominio público).
#
# Next.js la lee en tiempo de BUILD (npm run build) y de runtime. El deploy
# recompila en el servidor, así que este valor queda horneado en las metaetiquetas.
#
# Dominio final de producción.
NEXT_PUBLIC_SITE_URL=https://redadvenir.org

# ID del contenedor de Google Tag Manager (público, se hornea en el build).
# Desde GTM se administran GA4 y demás etiquetas de medición.
NEXT_PUBLIC_GTM_ID=GTM-P3LRDTH2

# Código de verificación de Google Search Console (etiqueta HTML). Solo el valor,
# sin el prefijo "google-site-verification=". Es público (aparece en el HTML).
GOOGLE_SITE_VERIFICATION=332mAjB_gZmXd85GUA1zVfUnYFpGH4OFuw_4_1iNGi8
